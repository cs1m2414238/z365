# API mode is the production default. Demo values are only used when explicitly selected.
VITE_DATA_SOURCE=api
VITE_API_BASE_URL=/api/v1
# Optional default public profile. With no username, the root loads /users/me.
# VITE_PROFILE_USERNAME=your_username

# Development/preview proxy only; this variable is not included in the browser bundle.
BACKEND_PROXY_URL=http://localhost:8080
