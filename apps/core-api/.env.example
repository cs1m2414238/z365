# Environment Configuration for Z365 Core API
SERVER_PORT=8080

# Database (PostgreSQL 18)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=z365_db
DB_USER=z365_user
DB_PASSWORD=z365_password

# Spring Security / JWT (Foundation)
JWT_SECRET=z365_super_secure_secret_key_minimum_256_bits_length_12345
JWT_EXPIRATION_MS=86400000

# Service Endpoints (Distributed Workers)
AGENT_SERVICE_URL=http://localhost:8000
RUNNER_SERVICE_URL=http://localhost:8081

# Logging & Monitoring
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SQL=DEBUG

