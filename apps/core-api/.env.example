# Environment Configuration for Z365 Core API
SERVER_PORT=8080

# Database (PostgreSQL 18)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=z365_db
DB_USER=z365_user
DB_PASSWORD=z365_password

# Account sessions and provider access
SESSION_COOKIE_SECURE=false
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
GITHUB_API_TOKEN=
PLATFORM_SYNC_ENABLED=true

# Service Endpoints (Distributed Workers)
AGENT_SERVICE_URL=http://localhost:8000
RUNNER_SERVICE_URL=http://localhost:8081

# Logging & Monitoring
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SQL=DEBUG

